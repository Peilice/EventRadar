  "components": [
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "清除篩選、分享同步連結等次要動作；hover 填滿夕陽橘。",
      "html": "<button class=\"ds-btn-ghost\">清除篩選</button>",
      "css": ".ds-btn-ghost{min-height:40px;padding:6px 16px;border:2px solid #15213f;border-radius:999px;background:transparent;color:#15213f;font-family:'Chiron GoRound TC','Noto Sans TC',sans-serif;font-weight:800;font-size:1rem;cursor:pointer;transition:background-color .18s,color .18s}.ds-btn-ghost:hover{background:#ff6b35;border-color:#ff6b35;color:#15213f}.ds-btn-ghost:focus-visible{outline:3px solid #ff6b35;outline-offset:3px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "篩選 chip，帶計數；按下有壓下手感，選取時反轉為墨底。",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-chip\">今天新增 <span class=\"ds-chip-count\">5</span></button><button class=\"ds-chip\" aria-pressed=\"true\">想去 <span class=\"ds-chip-count\">2</span></button></div>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:38px;padding:4px 14px;border-radius:999px;border:2px solid #15213f;background:#fff;color:#15213f;box-shadow:2px 2px 0 #15213f;font-family:'Chiron GoRound TC','Noto Sans TC',sans-serif;font-weight:700;font-size:.9rem;cursor:pointer;transition:transform .18s cubic-bezier(.22,1,.36,1),box-shadow .18s cubic-bezier(.22,1,.36,1)}.ds-chip:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 #15213f}.ds-chip:active{transform:translate(2px,2px);box-shadow:0 0 0 #15213f}.ds-chip:focus-visible{outline:3px solid #ff6b35;outline-offset:3px}.ds-chip[aria-pressed=true]{background:#15213f;color:#fff5e3}.ds-chip-count{min-width:1.6em;padding:0 6px;border-radius:999px;background:#e9dcc2;color:#15213f;font-family:Fredoka,sans-serif;font-size:.78rem;text-align:center}.ds-chip[aria-pressed=true] .ds-chip-count{background:#ffc93c}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "暖白底、墨線、焦點時鳳梨黃光圈。",
      "html": "<label class=\"ds-field\"><span>關鍵字</span><input class=\"ds-input\" type=\"search\" placeholder=\"活動名稱、場地、主辦單位\"></label>",
      "css": ".ds-field{display:grid;gap:6px;max-width:320px}.ds-field>span{font-family:'Chiron GoRound TC','Noto Sans TC',sans-serif;font-weight:800;font-size:.85rem;color:#15213f}.ds-input{min-height:44px;padding:8px 12px;background:#fffaf0;border:2px solid #15213f;border-radius:12px;color:#15213f;font:inherit;transition:box-shadow .2s cubic-bezier(.22,1,.36,1),background-color .2s}.ds-input::placeholder{color:#4b5675}.ds-input:hover{background:#fff}.ds-input:focus-visible{outline:none;background:#fff;box-shadow:0 0 0 3px #ffc93c}"
    },
    {
      "name": "Event Card",
      "kind": "card",
      "refersTo": "event-card",
      "description": "分類色頂條＋標記按鈕＋時間地點主辦；hover 浮起。",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-cat\"><svg viewBox=\"0 0 24 24\"><path d=\"M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z\"/><path d=\"M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z\"/></svg>講座／課程<span class=\"ds-mark\">想去</span></div><h3>永生花藝相框手作</h3><p class=\"ds-when\">10/26（一） 10:00–12:00</p><p class=\"ds-where\">一心路林森路口樓下全家 · 前鎮區</p><span class=\"ds-tag\">免費</span></article>",
      "css": ".ds-card{max-width:340px;background:#fff;border:2px solid #15213f;border-radius:20px;box-shadow:4px 4px 0 #15213f;padding:0 16px 14px;overflow:hidden;color:#15213f;transition:transform .25s cubic-bezier(.22,1,.36,1),box-shadow .25s cubic-bezier(.22,1,.36,1)}.ds-card:hover{transform:translate(-3px,-3px);box-shadow:7px 7px 0 #15213f}.ds-card-cat{display:flex;align-items:center;gap:8px;margin:0 -16px 12px;padding:9px 16px;background:color-mix(in oklab,#6d28d9 16%,#fff);border-bottom:2px solid #15213f;color:#6d28d9;font-family:'Chiron GoRound TC','Noto Sans TC',sans-serif;font-weight:800;font-size:.88rem}.ds-card-cat svg{width:1.3em;height:1.3em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-mark{margin-left:auto;padding:2px 10px;border-radius:999px;border:2px solid #15213f;background:#ff6b35;color:#15213f;box-shadow:2px 2px 0 #15213f;font-size:.8rem}.ds-card h3{margin:0 0 10px;font-family:'Chiron GoRound TC','Noto Sans TC',sans-serif;font-weight:800;font-size:1.12rem;line-height:1.4}.ds-card p{margin:0;font-size:.9rem}.ds-when{font-weight:700;color:#c2410c}.ds-where{color:#4b5675;margin-top:4px!important}.ds-tag{display:inline-block;margin-top:12px;padding:1px 10px;border-radius:999px;border:1.5px solid #15213f;background:#ffc93c;font-family:'Chiron GoRound TC','Noto Sans TC',sans-serif;font-weight:800;font-size:.78rem}"
    },
    {
